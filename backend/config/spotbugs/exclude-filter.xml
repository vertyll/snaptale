<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated code -->
    <Match>
        <Package name="~.*\.generated\..*"/>
    </Match>

    <!-- Exclude test serialization issues -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="SE_BAD_FIELD,SE_NO_SERIALVERSIONID"/>
    </Match>

    <!-- Exclude newline warnings for JSON request bodies built from text blocks in tests -->
    <Match>
        <Class name="~.*(Test|IT)"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!-- Exclude RuntimeException thrown by test fakes that simulate a failing collaborator -->
    <Match>
        <Class name="~.*Test\$.*"/>
        <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>

    <!-- Exclude MapStruct generated implementations -->
    <Match>
        <Class name="~.*MapperImpl"/>
    </Match>

    <!-- FindSecBugs: Ignore informational endpoints detection -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!-- FindSecBugs: Log injection is low risk in internal apps -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- FindSecBugs: the language cookie only picks ui_locales, and Language.of accepts nothing but pl or en -->
    <Match>
        <Class name="com.vertyll.snaptale.security.LocalizedAuthorizationRequestResolver"/>
        <Bug pattern="COOKIE_USAGE"/>
    </Match>

    <!-- FindSecBugs: kc_action is passed on only when it is one of the two Keycloak actions the resolver allows -->
    <Match>
        <Class name="com.vertyll.snaptale.security.LocalizedAuthorizationRequestResolver"/>
        <Bug pattern="SERVLET_PARAMETER"/>
    </Match>

    <!-- FindSecBugs: the language cookie holds a language tag only, and kc_action is only checked for presence -->
    <Match>
        <Class name="com.vertyll.snaptale.security.KeycloakLanguageFilter"/>
        <Bug pattern="COOKIE_USAGE,SERVLET_PARAMETER"/>
    </Match>

    <!-- Exclude exposure of internal representation issues -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
